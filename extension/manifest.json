{
  "manifest_version": 3,
  "name": "JobPulse Native Auto-Fill & Speed-Run",
  "version": "1.1.5",
  "description": "Auto-fills ATS job applications (including Shadow DOM forms like SmartRecruiters & Workday), attaches tailored PDFs, and surfaces Bot Trap alerts inside regular Chrome with zero CAPTCHA interference.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPulse Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.breezy.hr/*",
        "https://*.applytojob.com/*",
        "https://*.jazzhr.com/*",
        "https://*.recruitee.com/*",
        "https://*.jobvite.com/*",
        "https://*.dover.com/*",
        "https://*.gem.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workday.com/*",
        "https://*.icims.com/*",
        "https://*.rippling.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.smartr.me/*",
        "https://*.oraclecloud.com/*",
        "https://*.dayforcehcm.com/*",
        "https://*.ultipro.com/*",
        "https://*.paylocity.com/*",
        "https://*.paycomonline.net/*",
        "https://*.adp.com/*",
        "https://*.eightfold.ai/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.teamtailor.com/*",
        "https://*.trakstar.com/*",
        "https://*.indeed.com/*",
        "https://*.linkedin.com/*",
        "https://*.glassdoor.com/*",
        "https://*.ziprecruiter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
